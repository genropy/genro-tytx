{
  "name": "genro-tytx",
  "version": "0.15.0",
  "description": "TYTX - Typed Text Protocol for Scalar Types",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "imports": {
    "#dependencies": {
      "browser": "./src/platform/dependencies.browser.js",
      "default": "./src/platform/dependencies.node.js"
    }
  },
  "scripts": {
    "test": "node --test test/test_extended.js test/test_registry.js test/test_registry_lookup.js test/test_string_roundtrip.js test/test_browser_bundle.js",
    "test:all": "node --test test/test_*.js",
    "test:http": "node --test test/test_http.js",
    "build": "node build.js"
  },
  "keywords": [
    "tytx",
    "typed",
    "serialization",
    "json",
    "xml",
    "msgpack"
  ],
  "author": "Genropy Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickvazz/genro-tytx"
  },
  "optionalDependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "big.js": "^6.2.1",
    "decimal.js": "^10.4.3",
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
